# Copy this file to .env and fill in your real local values.
# This file is safe to commit because it contains no secrets.

GANACHE_RPC_URL=http://127.0.0.1:7545
GANACHE_PRIVATE_KEY=your_ganache_private_key_here
CONTRACT_ADDRESS=0xYourDeployedContractAddressHere

DB_HOST=localhost
DB_PORT=3306
DB_NAME=blockchain_storage
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

STORAGE_NODE1=storage_node1
STORAGE_NODE2=storage_node2
STORAGE_NODE3=storage_node3
STORAGE_EDGE=edge_node
